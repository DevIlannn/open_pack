{
  "name": "application",
  "version": "1.0.0",
  "description": "A web application with a Node.js backend and PostgreSQL database, providing user authentication, session management, a JSON API, and browser-based pages.",
  "keywords": [
    "application",
    "nodejs",
    "express",
    "postgresql",
    "session",
    "authentication",
    "api",
    "serverless"
  ],
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "core/index.js",
  "scripts": {
    "start": "node core/index.js",
    "dev": "nodemon core/index.js"
  },
  "nodemonConfig": {
    "watch": [
      "core",
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "public/**",
      "node_modules/**"
    ],
    "delay": 500
  },
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chalk": "^5.4.1",
    "compression": "^1.8.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.0",
    "sanitize-html": "^2.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}