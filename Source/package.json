{
  "name": "Application",
  "version": "1.2.4",
  "description": "A lightweight Node.js and Express backend foundation with PostgreSQL, session-based authentication, static page serving, and centralized error handling. Built for web and API projects that need a clean starting point, and ready to run locally or deploy to serverless platforms.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js"
  },
  "keywords": [
    "open-pack",
    "starter",
    "template",
    "boilerplate",
    "nodejs",
    "express",
    "postgresql",
    "session",
    "vercel",
    "backend",
    "fullstack",
    "esm"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "log-symbols": "^7.0.0",
    "ora": "^8.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
